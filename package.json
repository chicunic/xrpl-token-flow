{
  "name": "xrpl-token-flow",
  "version": "1.0.0",
  "description": "XRPL token flow management service",
  "keywords": [
    "xrp",
    "xrpl",
    "trust-line",
    "mptoken",
    "flow",
    "typescript"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "check": "tsc6 -b --noEmit && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "kb:capture": "KB_CAPTURE=1 vitest run",
    "kb:check": "tsx scripts/kb-check.ts",
    "kb:docs": "tsx scripts/kb-docs.ts",
    "kb:query": "tsx scripts/kb-query.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
